# VALIDAR NA HOSPEDAGEM FINAL ANTES DE PUBLICAR.
# Arquivo genérico para Apache (Locaweb, plano Linux). Confirmar que mod_rewrite, mod_expires, mod_deflate e mod_headers estão ativos
# e testar cada regra depois de subir: http e www para https sem www, redirecionamentos do WordPress antigo, página 404, cache e cabeçalhos.
# Se o servidor já força HTTPS por outro meio (painel, proxy), a regra de HTTPS abaixo pode causar loop: remova só a condição %{HTTPS}.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# ------------------------------------------------------------------
# Redirecionamentos 301
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Restos do WordPress padrão que o domínio tinha: tudo para a home (destino já em https, sem www, evita duas voltas)
  RewriteRule ^(hello-world|sample-page)/?$ https://dermatomarianazunino.com/ [R=301,L]
  RewriteRule ^wp-admin(/.*)?$ https://dermatomarianazunino.com/ [R=301,L]
  RewriteRule ^wp-login\.php$ https://dermatomarianazunino.com/ [R=301,L]
  RewriteRule ^feed(/.*)?$ https://dermatomarianazunino.com/ [R=301,L]
  # /?p=1 e /?page_id=2 (o "?" final descarta a query string)
  RewriteCond %{QUERY_STRING} (^|&)(p=1|page_id=2)(&|$)
  RewriteRule ^$ https://dermatomarianazunino.com/? [R=301,L]

  # 2) http para https e www para sem www, em um único salto
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://dermatomarianazunino.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ------------------------------------------------------------------
# Compressão
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# Cache
# Fontes e imagens: 1 ano. CSS e JS: 1 mês (os arquivos não têm hash no nome; ao publicar mudanças, acrescentar ?v=NUMERO nos <link> e <script> do HTML).
# HTML, sitemap, robots e manifest: sem cache longo.
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# ------------------------------------------------------------------
# Cabeçalhos de segurança
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(woff2|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Arquivos ocultos não são servidos
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
